import polars as pl

# 1. 定义 12 个特征列（必须和构建 FAISS 索引时完全一致）
FEATURE_COLS = [
    'danceability', 'energy', 'key', 'mode', 'loudness',
    'speechiness', 'acousticness', 'instrumentalness',
    'liveness', 'valence', 'tempo', 'time_signature'
]

# 2. 生成特征表
print("开始生成特征表...")
df_features = pl.scan_parquet("F:/airo/aipro/data/embeat_45m.parquet")
df_features = df_features.select(['track_id'] + FEATURE_COLS)
df_features.sink_parquet("F:/airo/aipro/data/metadata_features.parquet")
print("✅ 特征表已生成: metadata_features.parquet")

# 3. 生成基础信息表
print("开始生成基础信息表...")
LIGHT_COLS = [
    'track_id', 'track_name', 'artist_name', 'popularity',
    'album_name', 'artist_genres', 'artist_idx', 'isrc'
]
df_light = pl.scan_parquet("F:/airo/aipro/data/embeat_45m.parquet")
df_light = df_light.select(LIGHT_COLS)
df_light.sink_parquet("F:/airo/aipro/data/metadata_light.parquet")
print("✅ 基础信息表已生成: metadata_light.parquet")

# 4. 验证文件大小
import os
for f in ["metadata_features.parquet", "metadata_light.parquet"]:
    path = f"F:/airo/aipro/data/{f}"
    size = os.path.getsize(path) / (1024**3)
    print(f"{f}: {size:.2f} GB")