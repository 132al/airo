# scripts/test_pipeline.py
from webtest.tag_retriever import multi_recall, select_tags
from webtest.track_retriever import find_tracks_by_tags

def main():
    queries = [
        "印度电影歌",
        "适合跑步听的歌",
        "失恋了想听点伤感的",
        "适合开车长途的音乐",
        "适合咖啡馆放的背景音乐",
        "想听点暴躁的重金属",
        "适合睡前放松的纯音乐",
        "适合冬天听的温暖民谣",
        "爵士",
        "来点摇滚",
        "想听点慵懒的",
        "韩流",
        "动漫歌",
        "健身听的",
        "助眠",
    ]

    for q in queries:
        print(f"\n{'='*70}")
        print(f"用户输入：{q}")

        candidates = multi_recall(q, per_path=15)
        print(f"\n[1] 召回候选：{len(candidates)} 个")
        for c in candidates[:10]:
            print(f"    {c['weighted_score']:.3f}  {c['tag']}  ({c['source']})")

        selected = select_tags(q, candidates, top_n=5)
        print(f"\n[2] 选中标签：{selected}")

        tracks = find_tracks_by_tags(selected, limit=20)
        print(f"\n[3] 候选歌曲：{len(tracks)} 首")
        for t in tracks[:5]:
            print(f"    {t['track_name']} - {t['artist_name']}")
            print(f"       流派: {t['artist_genres'][:80]}")
            print(f"       命中: {t['hit_count']}")

if __name__ == "__main__":
    main()